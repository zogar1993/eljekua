{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "web/core/*": [
        "../src_tests/web/core/*"
      ],
      "*": [
        "*"
      ]
    },
    "moduleResolution": "node",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "sourceMap": true,
    "types": ["jest", "jest-extended"]
  },
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": []
}