{
  "name": "ts-html-app",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "esbuild src/core/main.ts --bundle --outfile=dist/bundle.js --format=esm --sourcemap && pnpm build:power-editor",
    "build:power-editor": "esbuild src/power_editor/main.ts --bundle --outfile=dist/power-editor.js --format=esm --sourcemap",
    "watch": "esbuild src/core/main.ts --bundle --outfile=dist/bundle.js --format=esm --sourcemap --watch",
    "watch:power-editor": "esbuild src/power_editor/main.ts --bundle --outfile=dist/power-editor.js --format=esm --sourcemap --watch",
    "dev": "concurrently -k \"pnpm:watch\" \"pnpm:start\"",
    "dev:power-editor": "concurrently -k \"pnpm:watch:power-editor\" \"live-server --open=./power-editor.html --watch=./\"",
    "start": "live-server --open=./index.html --watch=./"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "concurrently": "9.1.2",
    "cypress": "15.1.0",
    "esbuild": "0.25.3",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-extended": "6.0.0",
    "live-server": "1.2.2",
    "ts-jest": "29.4.4",
    "typescript": "5.8.3"
  }
}